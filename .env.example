# Optional prepared AI corpus host. Omit to use a local fixture or arXiv.
# Copy to .env and restart the server. Existing exported variables take precedence.
MINDSPACE_PAPERS_BASE_URL=https://inside.makehorses.org/ai-papers
# This host resolves to the operator's private network. Enable only for a trusted
# private corpus hostname. Literal IPs/localhost are explicitly trusted endpoints.
MINDSPACE_PAPERS_ALLOW_PRIVATE=true
